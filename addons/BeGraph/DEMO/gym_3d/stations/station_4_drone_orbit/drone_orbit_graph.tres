[sub_resource type="Resource" id="SubResource_ap"]
resource_name = "AccessPoint"
script = ExtResource("3_ap")
label = "Start"
node_category = "access_point_node"
output = true
position_in_graph = Vector2(-280, 0)
is_starting_node = true
_graph_ref = Object(WeakRef,"script":null)

_next_ref = Array[StringName]([&"FOVCheck"])
breakpointable = true
mutable = true

[sub_resource type="Resource" id="SubResource_fov"]
resource_name = "FOVCheck"
script = ExtResource("4_fov")
node = NodePath(".")
target = NodePath("../../../Player3D")
angle = 120.0
max_distance = 8.0
forward = 4
instruction = "Field of view {node} -> {target}"
conditions = Array[Dictionary]([{
"next": &"StandoffSequence",
"text": "Target in field of view"
}, {
"next": &"OrbitSequence",
"text": "Target not in field of view"
}])
node_category = "control_flow_node"
input = true
position_in_graph = Vector2(-80, 0)
_graph_ref = Object(WeakRef,"script":null)

breakpointable = true
mutable = true

