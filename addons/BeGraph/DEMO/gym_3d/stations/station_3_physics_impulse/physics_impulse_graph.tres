[sub_resource type="Resource" id="SubResource_ap"]
resource_name = "AccessPoint"
script = ExtResource("3_ap")
label = "Start"
node_category = "access_point_node"
output = true
position_in_graph = Vector2(-300, 0)
is_starting_node = true
_graph_ref = Object(WeakRef,"script":null)

_next_ref = Array[StringName]([&"AreaTrigger"])
breakpointable = true
mutable = true

[sub_resource type="Resource" id="SubResource_area"]
resource_name = "AreaTrigger"
script = ExtResource("4_area")
area = NodePath("../PitTriggerArea")
instruction = "Check bodies overlapping {area}"
conditions = Array[Dictionary]([{
"next": &"ImpulseLoop",
"text": "Body detected"
}, {
"next": null,
"text": "No body detected"
}])
node_category = "control_flow_node"
input = true
position_in_graph = Vector2(-100, 0)
_graph_ref = Object(WeakRef,"script":null)

breakpointable = true
mutable = true

[sub_resource type="Resource" id="SubResource_rep"]
resource_name = "ImpulseLoop"
script = ExtResource("5_rep")
times = 0
instruction = "Repeat {times} times"
node_category = "control_flow_node"
input = true
output = true
position_in_graph = Vector2(120, 0)
_graph_ref = Object(WeakRef,"script":null)

_next_ref = Array[StringName]([&"LaunchSequence"])
breakpointable = true
mutable = true

[sub_resource type="Resource" id="SubResource_imp_a"]
