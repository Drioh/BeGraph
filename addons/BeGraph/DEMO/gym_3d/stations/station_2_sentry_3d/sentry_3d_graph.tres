[sub_resource type="Resource" id="SubResource_dist"]
resource_name = "DistanceCheck"
script = ExtResource("4_dist")
node_a = NodePath(".")
node_b = NodePath("../../../Player3D")
threshold = 14.0
instruction = "Distance {node_a} - {node_b} vs {threshold}"
conditions = Array[Dictionary]([{
"next": "DimSpotLight",
"text": "distance > {threshold}"
}, {
"next": null,
"text": "distance = {threshold}"
}, {
"next": &"LOSCheck",
"text": "distance < {threshold}"
}])
node_category = "control_flow_node"
input = true
position_in_graph = Vector2(-1200, -300)
_graph_ref = Object(WeakRef,"script":null)

_blackboard_bindings = Dictionary[StringName, StringName]({
&"node_a": &"Self",
&"node_b": &"Player"
})
breakpointable = true
mutable = true

