; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[BeGraph]

general_settings/custom_nodes_paths=PackedStringArray("res://Additional Nodes/")
general_settings/runtime_debug_overlay_enabled=true

[application]

config/name="BeGraph"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BeGraphDebugBridge="*uid://dfticjtnj7mb6"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

disabled=PackedStringArray("res://addons/begraph/plugin.cfg")
enabled=PackedStringArray("res://addons/BeGraph/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

[importer_defaults]

svg={
"base_scale": 1.0,
"color_map": {},
"compress": true,
"fix_alpha_border": false,
"premult_alpha": false,
"saturation": 1.0
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
